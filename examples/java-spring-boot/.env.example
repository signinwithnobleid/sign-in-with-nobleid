# Copy to .env (never commit it) and export before `java -jar`.
ISSUER=https://id.nobleid.org
CLIENT_ID=nbcl_your_client_id
CLIENT_SECRET=nbcs_your_client_secret
# Spring Security's callback path is /login/oauth2/code/{registrationId}; register this exact URI.
REDIRECT_URI=http://localhost:8080/login/oauth2/code/nobleid
PORT=8080
