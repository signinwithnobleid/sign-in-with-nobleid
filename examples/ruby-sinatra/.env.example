# Copy to .env (never commit it) or export these in your shell.
ISSUER=https://id.nobleid.org
CLIENT_ID=nbcl_your_client_id
CLIENT_SECRET=nbcs_your_client_secret
REDIRECT_URI=http://localhost:3000/auth/nobleid/callback
# Optional; space-separated. The user may untick any of these except openid.
SCOPE=openid profile email orcid affiliations works offline_access
