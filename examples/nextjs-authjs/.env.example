# Copy to .env.local and fill in. Never commit the real values.
ISSUER=https://id.nobleid.org
CLIENT_ID=nbcl_your_client_id
CLIENT_SECRET=nbcs_your_client_secret

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# The public URL of this app. The redirect URI is AUTH_URL + /api/auth/callback/nobleid
AUTH_URL=http://localhost:3000
# Only behind a proxy you control that sets the Host header:
# AUTH_TRUST_HOST=true

# Optional: narrower scope (openid is required)
# SCOPE=openid profile email orcid affiliations works offline_access
