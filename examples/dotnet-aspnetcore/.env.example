# Copy to .env and fill in. Never commit .env.
ISSUER=https://id.nobleid.org
CLIENT_ID=nbcl_your_client_id
CLIENT_SECRET=nbcs_your_client_secret
REDIRECT_URI=http://localhost:3000/signin-oidc
PORT=3000
# Optional: where ASP.NET Core keeps its cookie-encryption keys. Set this in
# production (shared by every instance) so sign-ins survive restarts.
# DATA_PROTECTION_KEYS_DIR=/var/lib/nobleid-example/keys
