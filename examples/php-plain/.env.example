# Copy to .env (never commit it), then load it before starting the server:
#   set -a; . ./.env; set +a
ISSUER=https://id.nobleid.org
CLIENT_ID=nbcl_your_client_id
CLIENT_SECRET=nbcs_your_client_secret
# Register this exact URI. The port must match the one given to `php -S`.
REDIRECT_URI=http://localhost:3000/callback
# Optional; space-separated. The user may untick any scope except openid; the app reads what was granted.
SCOPE=openid profile email orcid affiliations works offline_access
